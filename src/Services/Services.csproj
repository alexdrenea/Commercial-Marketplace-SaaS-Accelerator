<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <Authors>Microsoft.Marketplace</Authors>
	  <Company>Microsoft</Company>
	  <Product>Marketplace.SaaS.Accelerator</Product>
	  <AssemblyName>Services</AssemblyName>
	  <RootNamespace>Marketplace.SaaS.Accelerator.Services</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<!-- Provides Microsoft.AspNetCore.Mvc.* types (SelectList, ViewDataDictionary, IModelMetadataProvider, etc.)
		 via the shared framework instead of the outdated standalone ViewFeatures 2.1.3 package. -->
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Marketplace.SaaS.Client" Version="2.2.0" />
	<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	<!-- Version pinned above the transitive default to remediate a known vulnerability in an older
		 transitively-referenced version. TODO: re-check after .NET 10 upgrade whether this pin is still required. -->
	<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
	<!-- System.Linq.Async removed: .NET 10 now ships System.Linq.AsyncEnumerable (incl. ToListAsync) natively in the
		 BCL, which conflicted (CS0121 ambiguous call) with this package's extension methods of the same signature. -->

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataAccess\DataAccess.csproj" />
  </ItemGroup>

</Project>